# Required
RPC_URL=
CHAIN_ID=8453
DEPLOYER_ADDRESS=
CONTROLLER_ADDRESS=
BRLA_ADDRESS=0xfcb34c47f850f452c15ea1b84d51231c38a61783

# Required for a real run, ignored with --simulate
ETHERSCAN_API_KEY=

# Optional. The ByHoldings factory owner defaults to the deployer when absent.
# TOKEN_DISTRIBUTOR_BY_HOLDINGS_FACTORY_OWNER=

# Optional. Contract verification defaults to BaseScan through Etherscan.
# VERIFIER=etherscan
# VERIFIER_URL=https://api.basescan.org/api

# Optional. Where the deployer keystore lives, when not ~/.foundry/keystores.
# FOUNDRY_ETH_KEYSTORE=

# Optional. Setting one of these adopts an existing contract and skips deploying
# it, so leave them unset for a fresh generation.
# OFFER_TOKEN_FACTORY_ADDRESS=
# OFFER_TOKEN_SALE_FACTORY_ADDRESS=
# TOKEN_DISTRIBUTOR_FACTORY_ADDRESS=
# TOKEN_DISTRIBUTOR_BY_HOLDINGS_FACTORY_ADDRESS=
# ALLOWLIST_ADDRESS=
