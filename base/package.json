{
  "name": "bwb-contracts",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "forge build && npm run typechain && tsc",
    "typechain": "typechain --target ethers-v5 --out-dir src/typechain \"out/!(build-info)/**/!(*.dbg).json\"",
    "ts": "ts-node -T",
    "simulate:distribution": "DOTENV_CONFIG_PATH=.env ts-node -r dotenv/config -T src/simulateDistribution.ts",
    "simulate:offer": "DOTENV_CONFIG_PATH=.env ts-node -r dotenv/config -T src/simulateOffer.ts",
    "test": "forge test",
    "oz-validate": "npx @openzeppelin/upgrades-core validate --exclude \"src/test/**\" --exclude \"test/**\"",
    "anvil": "anvil --mnemonic \"test test test test test test test test test test test junk\" --derivation-path \"m/44'/60'/0'/0/\" --accounts 10 --balance 10000 --chain-id 31337 --timestamp 1700000000 --gas-limit 30000000 --base-fee 0 --host 127.0.0.1 --port 8545"
  },
  "dependencies": {
    "dotenv": "^10.0.0",
    "ethers": "^5.8.0"
  },
  "devDependencies": {
    "@openzeppelin/upgrades-core": "^1.44.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^4.9.5"
  }
}
