{
  "name": "@bwb-labs/sdk",
  "version": "1.0.0",
  "description": "BWB's integrations SDK: one sale interface with a strategy per chain, plus the Stellar transaction layer for wallets, sponsored reserves, relayed envelopes, treasury multisigs and offering deployment",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BWB-Labs/bwb-stellar.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.4.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
